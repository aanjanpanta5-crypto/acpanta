# Copy this file to .env on your computer, or add these as environment
# variables in your hosting dashboard. Never commit the real .env file.

# Stripe secret key. Use sk_test_... on your computer and sk_live_... on the live site.
STRIPE_SECRET_KEY=

# Your live website address, no slash at the end. Example: https://www.acpanta.com
BASE_URL=

# Number of proxies in front of the app. 1 is right for most hosts (Render, Railway, Heroku).
TRUST_PROXY=1

# Set to production on the live site so errors never show technical details.
NODE_ENV=production
